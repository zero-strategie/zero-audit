# ---- API (`serve`, audits, migrate) ----
# Listening address. Default 127.0.0.1; use 0.0.0.0 only inside a container, and publish
# the port on 127.0.0.1 only: the API must never be exposed publicly. It trusts the web server,
# which holds the sign-in; authentication goes through the web.
# HOST=127.0.0.1
# Listening port. Default 3000. The --port option wins over this variable.
# PORT=3000
# Storage: sqlite (default) or postgres. An option --store wins over this variable.
ZERO_AUDIT_STORE=sqlite
# Path of the SQLite database file (the folder is created on first run).
ZERO_AUDIT_DB_PATH=./.zero-audit/audit.db
# Postgres connection, read when the store is postgres (example values only).
DATABASE_URL=postgresql://zero_audit:change-me@127.0.0.1:5432/zero_audit
# Password given to the local Postgres started by docker compose (use the same one in DATABASE_URL).
POSTGRES_PASSWORD=change-me
# Delay in milliseconds between two requests to the audited site (read by `audit` and `serve`).
ZERO_AUDIT_DELAY_MS=1000
# By default `serve` refuses to crawl hosts that are, or resolve to, internal addresses
# (loopback, private networks, link-local), so that an audit cannot reach Postgres or the API.
# Set to the exact value `true` to turn that guard off (local development only).
# ZERO_AUDIT_ALLOW_PRIVATE_TARGETS=true
# E-mail sending. Unset: mailer disabled (sign-up and password reset answer 503).
#   console: writes the single-use links to the output; forbidden in production (serve warns).
#   brevo:   sends through the Brevo HTTP API; requires the two variables below.
# ZERO_AUDIT_MAILER=brevo
# Brevo API key (example value only, never commit a real key).
# ZERO_AUDIT_BREVO_API_KEY=xkeysib-change-me
# Sender address. Default no-reply@agents.zero-strategie.dev.
# ZERO_AUDIT_MAIL_FROM=no-reply@agents.zero-strategie.dev
# Public address of the dashboard used in e-mail links: absolute URL, no trailing slash.
# ZERO_AUDIT_PUBLIC_URL=https://audit.example.test
# Administrator addresses: comma-separated, compared case-insensitively. They still have to verify
# their address; /auth/me reports isAdmin for them.
# ZERO_AUDIT_ADMIN_EMAILS=admin@example.test
# Ceiling of audits launched through the API per rolling 24 hours, all accounts together
# (administrators included, the command line excluded). Positive integer, 30 when unset.
# ZERO_AUDIT_LAUNCHES_PER_DAY=30
# Where `serve` runs the audit worker: `embedded` (default, inside the serve process) or `external`
# (a separate worker process; audits stay queued until one runs). Any other value stops serve.
# ZERO_AUDIT_WORKER=embedded
# Ceiling of audits waiting in the queue, all accounts together (the running ones do not count).
# Positive integer, 20 when unset.
# ZERO_AUDIT_QUEUE_MAX=20
# Audits a dedicated `worker` process runs in parallel. Positive integer, 1 when unset.
# ZERO_AUDIT_WORKER_CONCURRENCY=1
# Tests against Postgres run only when this is set. Use a separate throwaway database
# (create zero_audit_test by hand), never the one in DATABASE_URL:
#   TEST_DATABASE_URL=postgresql://zero_audit:change-me@127.0.0.1:5432/zero_audit_test pnpm test
