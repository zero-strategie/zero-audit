# Storage: sqlite (default) or postgres. An option --store wins over this variable.
ZERO_AUDIT_STORE=sqlite
# Path of the SQLite database file (the folder is created on first run).
ZERO_AUDIT_DB_PATH=./.zero-audit/audit.db
# Postgres connection, read when the store is postgres (example values only).
DATABASE_URL=postgresql://zero_audit:change-me@127.0.0.1:5432/zero_audit
# Password given to the local Postgres started by docker compose (use the same one in DATABASE_URL).
POSTGRES_PASSWORD=change-me
# Delay in milliseconds between two requests to the audited site (read by `audit` and `worker`).
ZERO_AUDIT_DELAY_MS=1000
# By default `worker` refuses to crawl hosts that are, or resolve to, internal addresses
# (loopback, private networks, link-local). Set to the exact value `true` to turn that guard
# off (local development only).
# ZERO_AUDIT_ALLOW_PRIVATE_TARGETS=true
# Audits a dedicated `worker` process runs in parallel. Positive integer, 1 when unset.
# ZERO_AUDIT_WORKER_CONCURRENCY=1
# Tests against Postgres run only when this is set. Use a separate throwaway database
# (create zero_audit_test by hand), never the one in DATABASE_URL:
#   TEST_DATABASE_URL=postgresql://zero_audit:change-me@127.0.0.1:5432/zero_audit_test pnpm test
