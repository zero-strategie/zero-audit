---
import ErrorView from '../components/ErrorView.astro';
import FormAlert from '../components/FormAlert.astro';
import Layout from '../layouts/Layout.astro';
import { InvalidRequest } from '../lib/api/errors';
import { toFailure } from '../lib/failure';
import { isSameOrigin } from '../lib/same-origin';
import { SESSION_COOKIE, SESSION_COOKIE_OPTIONS } from '../lib/session-cookie';
import { isUserFacingError } from '../lib/user-facing-error';

const HTTP_FORBIDDEN = 403;
const HTTP_SEE_OTHER = 303;
const INVALID_LINK = 'Ce lien est invalide ou a expiré';

let token = Astro.url.searchParams.get('token') ?? '';
let message: string | null = null;
let failure = null;

// Activation is a POST so that a mail scanner opening the link cannot consume the token.
if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return new Response('Forbidden', { status: HTTP_FORBIDDEN });
  token = String((await Astro.request.formData()).get('token') ?? '');
  try {
    const sessionId = await Astro.locals.apiClient.verifyEmail(token);
    Astro.cookies.set(SESSION_COOKIE, sessionId, SESSION_COOKIE_OPTIONS);
    return Astro.redirect('/audits/new', HTTP_SEE_OTHER);
  } catch (error) {
    if (error instanceof InvalidRequest) {
      message = INVALID_LINK;
    } else if (isUserFacingError(error)) {
      message = error.message;
    } else {
      failure = toFailure(error);
      Astro.response.status = failure.status;
    }
  }
}
if (token === '') message = INVALID_LINK;
---

{
  failure ? (
    <ErrorView failure={failure} />
  ) : (
    <Layout title="Confirmer mon adresse – zero-audit">
      <h1>Confirmer mon adresse e-mail</h1>
      <FormAlert message={message} />
      {
        token !== '' && (
          <form method="post" action="/verifier-email">
            <input type="hidden" name="token" value={token} />
            <button type="submit" class="button-primary">Activer mon compte</button>
          </form>
        )
      }
    </Layout>
  )
}
