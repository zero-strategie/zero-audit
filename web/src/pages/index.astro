---
import ErrorView from '../components/ErrorView.astro';
import ProjectsTable from '../components/ProjectsTable.astro';
import Layout from '../layouts/Layout.astro';
import type { ProjectOverview } from '../lib/api/types';
import { toFailure } from '../lib/failure';

let projects: ProjectOverview[] = [];
const user = Astro.locals.user;
let failure = null;
try {
  projects = await Astro.locals.apiClient.listProjects();
} catch (error) {
  failure = toFailure(error);
  Astro.response.status = failure.status;
}
const mine = projects.filter(({ owned }) => owned);
const showcase = projects.filter(({ owned }) => !owned);
---

{
  failure ? (
    <ErrorView failure={failure} />
  ) : (
    <Layout title="Projets – zero-audit">
      <h1>Projets</h1>
      {user ? (
        <>
          <p><a href="/audits/new" class="button-primary">Nouvel audit</a></p>
          <section aria-labelledby="mes-projets">
            <h2 id="mes-projets">Mes projets</h2>
            {mine.length === 0 ? (
              <p>
                Aucun audit n'a encore été lancé. <a href="/audits/new">Lancez votre premier audit</a>.
              </p>
            ) : (
              <ProjectsTable projects={mine} canRelaunch />
            )}
          </section>
        </>
      ) : (
        <p>
          Créez un compte gratuit pour auditer votre site.
          <a href="/inscription" class="button-primary">Créer un compte</a>
        </p>
      )}
      <section aria-labelledby="vitrine">
        <h2 id="vitrine">Vitrine</h2>
        {showcase.length === 0 ? (
          <p>La vitrine est vide pour le moment.</p>
        ) : (
          <ProjectsTable projects={showcase} canRelaunch={Boolean(user)} />
        )}
      </section>
    </Layout>
  )
}
