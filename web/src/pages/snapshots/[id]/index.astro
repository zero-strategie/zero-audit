---
import ErrorView from '../../../components/ErrorView.astro';
import HealthGauge from '../../../components/HealthGauge.astro';
import RelaunchForm from '../../../components/RelaunchForm.astro';
import SeverityBadge from '../../../components/SeverityBadge.astro';
import SnapshotSelector from '../../../components/SnapshotSelector.astro';
import ThemeCard from '../../../components/ThemeCard.astro';
import Layout from '../../../layouts/Layout.astro';
import type { SnapshotListing, SnapshotReport, Theme } from '../../../lib/api/types';
import { relaunchLimit } from '../../../lib/audit-limits';
import { toFailure } from '../../../lib/failure';
import { PAGE_GROUP_LABELS, SITE_FILE_LABELS } from '../../../lib/labels';
import { formatDateFr, formatVariation } from '../../../lib/presentation';

const snapshotId = Astro.params.id ?? '';
let report: SnapshotReport | null = null;
let snapshots: SnapshotListing[] = [];
let failure = null;
try {
  report = await Astro.locals.apiClient.getSnapshotReport(snapshotId);
  snapshots = await Astro.locals.apiClient.listProjectSnapshots(report.snapshot.projectId);
} catch (error) {
  failure = toFailure(error);
  Astro.response.status = failure.status;
}

const counters = report && [
  { key: 'errors', label: 'Erreurs', value: report.counts.errors },
  { key: 'warnings', label: 'Avertissements', value: report.counts.warnings },
  { key: 'notices', label: 'Notices', value: report.counts.notices },
];
const siteFileStatus = (status: number | null, error: string | null) =>
  status === null ? (error ?? 'Injoignable') : String(status);
const statusClass = (status: number | null) =>
  status === null || status >= 400 ? 'status-bad' : status >= 300 ? 'status-redirect' : 'status-ok';
const host = report ? new URL(report.snapshot.rootUrl).host : '';
/* Groups in the stacked bar: only those with pages, sized by their count. */
const groupBar = report
  ? Object.entries(report.pageGroups).filter(([, { count }]) => count > 0)
  : [];
---

{
  failure || !report ? (
    <ErrorView failure={failure ?? { kind: 'not-found', status: 404 }} />
  ) : (
    <Layout
      title={`${host} – Vue d'ensemble – zero-audit`}
      projectId={report.snapshot.projectId}
      snapshotId={report.snapshot.id}
    >
      <header class="report-head">
        <div>
          <span class="eyebrow">Vue d'ensemble · relevé d'audit SEO</span>
          <h1>{host}</h1>
          <p class="report-meta">
            <span>
              Relevé du <strong>{formatDateFr(report.snapshot.startedAt)}</strong>
            </span>
            <span>
              <strong>{report.snapshot.pagesCrawled}</strong> / {report.snapshot.pagesLimit} pages explorées
            </span>
          </p>
        </div>
        <div class="report-actions">
          <SnapshotSelector snapshots={snapshots} currentId={report.snapshot.id} />
          {Astro.locals.user && (
            <RelaunchForm
              url={report.snapshot.rootUrl}
              limit={relaunchLimit(report.snapshot.pagesLimit)}
              label="Relancer l'audit"
            />
          )}
        </div>
      </header>

      <div class="report-grid">
        <section class="report-dial panel">
          <h2>Santé du site</h2>
          <HealthGauge score={report.health.score} variation={report.health.variation} />
        </section>

        <div class="report-readings">
          <section>
            <h2>Thèmes</h2>
            <ul class="theme-cards">
              {Object.entries(report.themes).map(([theme, { score, variation }], index) => (
                <ThemeCard theme={theme as Theme} score={score} variation={variation} index={index} />
              ))}
            </ul>
          </section>

          <section>
            <h2 class="heading-with-link">
              Problèmes <a href={`/snapshots/${report.snapshot.id}/issues`}>Voir tous les problèmes</a>
            </h2>
            <ul class="counts">
              {(counters ?? []).map(({ key, label, value }, index) => (
                <li class="count enter" style={`--i: ${String(index + 6)}`}>
                  <b data-testid={`count-${key}`}>{value}</b>
                  <span class={`shape shape-${key}`}>{label}</span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>Principaux problèmes</h2>
            <ol class="top-issues">
              {report.topIssues.map(({ checkId, label, severity, count }, index) => (
                <li class="enter" style={`--i: ${String(index + 8)}`}>
                  <SeverityBadge severity={severity} />
                  <a href={`/snapshots/${report.snapshot.id}/issues/${String(checkId)}`}>{label}</a>
                  <span class="occurrences">{count}</span>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>

      <div class="report-lower">
        <section>
          <h2>Pages explorées</h2>
          <div class="group-bar" aria-hidden="true">
            {groupBar.map(([group, { count }]) => (
              <span class={`group-${group}`} style={`flex-grow: ${String(count)}`} />
            ))}
          </div>
          <ul class="group-legend">
            {Object.entries(report.pageGroups).map(([group, { count, variation }]) => (
              <li data-testid={`group-${group}`} data-group={group}>
                {PAGE_GROUP_LABELS[group as keyof typeof PAGE_GROUP_LABELS]} : {count} ({formatVariation(variation)})
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Fichiers techniques</h2>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Fichier</th>
                  <th scope="col">Adresse</th>
                  <th scope="col">Statut</th>
                </tr>
              </thead>
              <tbody>
                {report.siteFiles.map(({ kind, url, status, error }) => (
                  <tr data-testid={`site-file-${kind}`}>
                    <td>{SITE_FILE_LABELS[kind]}</td>
                    <td class="cell-url">{url}</td>
                    <td class={statusClass(status)}>{siteFileStatus(status, error)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </Layout>
  )
}
