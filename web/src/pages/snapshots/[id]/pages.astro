---
import ErrorView from '../../../components/ErrorView.astro';
import Layout from '../../../layouts/Layout.astro';
import type { PageListing } from '../../../lib/api/types';
import { toFailure } from '../../../lib/failure';
import { PAGE_GROUP_LABELS } from '../../../lib/labels';
import { buildPaginationLinks, parsePageParam } from '../../../lib/pagination';
import { formatStatus } from '../../../lib/presentation';
import { nextSort, parseSortParam, type PageSortColumn } from '../../../lib/sorting';

// A null column is not sortable (the group is derived, the API cannot order by it).
const COLUMNS: { column: PageSortColumn | null; label: string }[] = [
  { column: 'url', label: 'URL' },
  { column: 'status', label: 'Statut' },
  { column: 'depth', label: 'Profondeur' },
  { column: null, label: 'Groupe' },
  { column: 'issues', label: 'Problèmes' },
  { column: 'responseTime', label: 'Temps de réponse' },
];

const snapshotId = Astro.params.id ?? '';
const sortParam = parseSortParam(Astro.url.searchParams.get('sort'));
const sort = sortParam.kind === 'valid' ? sortParam.sort : 'url';
const pageNumber = parsePageParam(Astro.url.searchParams.get('page'));
let listing: PageListing | null = null;
let failure = null;
try {
  listing = await Astro.locals.apiClient.listPages(snapshotId, pageNumber, sort);
} catch (error) {
  failure = toFailure(error);
  Astro.response.status = failure.status;
}
const links = listing && buildPaginationLinks(listing.page, listing.limit, listing.total);
const pageHref = (page: number) => `?page=${String(page)}&sort=${sort}`;
---

{
  failure || !listing ? (
    <ErrorView failure={failure ?? { kind: 'not-found', status: 404 }} />
  ) : (
    <Layout title="Pages explorées – zero-audit">
      <h1>Pages explorées</h1>
      <nav>
        <a href={`/snapshots/${snapshotId}`}>Vue d'ensemble</a> ·
        <a href={`/snapshots/${snapshotId}/issues`}>Problèmes</a>
      </nav>

      {sortParam.kind === 'invalid' && (
        <p data-testid="invalid-sort">
          Le tri « {sortParam.raw} » est invalide : les pages sont triées par URL.
        </p>
      )}

      <p>{listing.total} page(s)</p>
      <table>
        <thead>
          <tr>
            {COLUMNS.map(({ column, label }) => (
              <th>
                {column ? <a href={`?sort=${nextSort(sort, column)}`}>{label}</a> : label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {listing.items.map((row) => (
            <tr data-testid={`row-${row.url}`}>
              <td>{row.url}</td>
              <td>{formatStatus(row.status)}</td>
              <td>{row.depth}</td>
              <td>{PAGE_GROUP_LABELS[row.group]}</td>
              <td>{row.issues}</td>
              <td>{row.responseTimeMs} ms</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p>
        {links?.previous != null && (
          <a data-testid="previous" href={pageHref(links.previous)}>Page précédente</a>
        )}
        {links?.next != null && (
          <a data-testid="next" href={pageHref(links.next)}>Page suivante</a>
        )}
      </p>
    </Layout>
  )
}
