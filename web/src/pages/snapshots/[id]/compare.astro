---
import ErrorView from '../../../components/ErrorView.astro';
import { toFailure, type Failure } from '../../../lib/failure';

// Lets snapshot screens link to the comparison without knowing the project.
let failure: Failure;
try {
  const report = await Astro.locals.apiClient.getSnapshotReport(Astro.params.id ?? '');
  return Astro.redirect(`/projects/${encodeURIComponent(report.snapshot.projectId)}/compare`);
} catch (error) {
  failure = toFailure(error);
  Astro.response.status = failure.status;
}
---

<ErrorView failure={failure} />
