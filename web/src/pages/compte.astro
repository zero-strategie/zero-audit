---
import ErrorView from '../components/ErrorView.astro';
import FormAlert from '../components/FormAlert.astro';
import Layout from '../layouts/Layout.astro';
import { toFailure } from '../lib/failure';
import { formatDateFr } from '../lib/presentation';
import { isSameOrigin } from '../lib/same-origin';
import { SESSION_COOKIE } from '../lib/session-cookie';
import { isUserFacingError } from '../lib/user-facing-error';

const HTTP_FORBIDDEN = 403;
const HTTP_SEE_OTHER = 303;

const user = Astro.locals.user;
if (Astro.request.method === 'POST' && !isSameOrigin(Astro.request)) {
  return new Response('Forbidden', { status: HTTP_FORBIDDEN });
}
if (!user) return Astro.redirect('/connexion?retour=/compte', HTTP_SEE_OTHER);

let message: string | null = null;
let failure = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    if (form.get('intent') === 'delete') {
      await Astro.locals.apiClient.deleteAccount(String(form.get('password') ?? ''));
      Astro.cookies.delete(SESSION_COOKIE, { path: '/' });
      return Astro.redirect('/', HTTP_SEE_OTHER);
    }
  } catch (error) {
    if (isUserFacingError(error)) {
      message = error.message;
    } else {
      failure = toFailure(error);
      Astro.response.status = failure.status;
    }
  }
}
---

{
  failure ? (
    <ErrorView failure={failure} />
  ) : (
    <Layout title="Mon compte – zero-audit">
      <h1>Mon compte</h1>
      <FormAlert message={message} />
      <dl>
        <dt>Adresse e-mail</dt>
        <dd>{user.email}</dd>
        <dt>Audits restants</dt>
        <dd>{user.auditsRemaining === null ? 'illimité' : user.auditsRemaining}</dd>
        {
          user.nextAuditAt && (
            <>
              <dt>Prochain audit possible</dt>
              <dd>{formatDateFr(user.nextAuditAt)}</dd>
            </>
          )
        }
      </dl>
      <h2>Supprimer mon compte</h2>
      <p>Vos projets et vos audits seront définitivement supprimés.</p>
      <form method="post" action="/compte">
        <input type="hidden" name="intent" value="delete" />
        <label>
          Mot de passe
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Supprimer mon compte</button>
      </form>
    </Layout>
  )
}
