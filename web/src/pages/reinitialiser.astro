---
import ErrorView from '../components/ErrorView.astro';
import FormAlert from '../components/FormAlert.astro';
import Layout from '../layouts/Layout.astro';
import { toFailure } from '../lib/failure';
import { isSameOrigin } from '../lib/same-origin';
import { isUserFacingError } from '../lib/user-facing-error';

const HTTP_FORBIDDEN = 403;
const HTTP_SEE_OTHER = 303;

let token = Astro.url.searchParams.get('token') ?? '';
let message: string | null = null;
let failure = null;

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return new Response('Forbidden', { status: HTTP_FORBIDDEN });
  const form = await Astro.request.formData();
  token = String(form.get('token') ?? '');
  try {
    await Astro.locals.apiClient.confirmPasswordReset({
      token,
      password: String(form.get('password') ?? ''),
    });
    return Astro.redirect('/connexion?reinitialise=1', HTTP_SEE_OTHER);
  } catch (error) {
    if (isUserFacingError(error)) {
      message = error.message;
    } else {
      failure = toFailure(error);
      Astro.response.status = failure.status;
    }
  }
}
---

{
  failure ? (
    <ErrorView failure={failure} />
  ) : (
    <Layout title="Nouveau mot de passe – zero-audit">
      <h1>Choisir un nouveau mot de passe</h1>
      <FormAlert message={message} />
      <form method="post" action="/reinitialiser">
        <input type="hidden" name="token" value={token} />
        <label>
          Nouveau mot de passe (12 caractères minimum)
          <input type="password" name="password" autocomplete="new-password" minlength="12" required />
        </label>
        <button type="submit" class="button-primary">Changer mon mot de passe</button>
      </form>
    </Layout>
  )
}
