---
import ErrorView from '../../components/ErrorView.astro';
import RelaunchForm from '../../components/RelaunchForm.astro';
import Layout from '../../layouts/Layout.astro';
import type { AuditProgress } from '../../lib/api/types';
import { relaunchLimit } from '../../lib/audit-limits';
import { toFailure } from '../../lib/failure';

const HTTP_SEE_OTHER = 303;
const REFRESH_SECONDS = 3;
const PERCENT = 100;
const MAX_ATTEMPTS = 2;

const snapshotId = Astro.params.id ?? '';
let progress: AuditProgress | null = null;
let failure = null;
try {
  progress = await Astro.locals.apiClient.getAuditProgress(snapshotId);
} catch (error) {
  failure = toFailure(error);
  Astro.response.status = failure.status;
}

if (progress?.status === 'finished') {
  return Astro.redirect(`/snapshots/${encodeURIComponent(snapshotId)}`, HTTP_SEE_OTHER);
}

const host = progress ? new URL(progress.rootUrl).host : '';
const hasCount = progress !== null && progress.pagesCrawled > 0;
const percent = progress ? Math.min(PERCENT, Math.round((progress.pagesCrawled / progress.pagesLimit) * PERCENT)) : 0;
const count = progress ? `${String(progress.pagesCrawled)} / ${String(progress.pagesLimit)} pages` : '';
const summary = `Audit de ${host} en cours` + (hasCount ? ` — ${count}` : '');
const isQueued = progress?.status === 'queued';
const isActive = isQueued || progress?.status === 'running';
const queueLine =
  progress?.queuePosition == null ? "En file d'attente" : `En file d'attente — position ${String(progress.queuePosition)}`;
const isResumed = progress !== null && progress.attempts > 1;
const resumeLine = `Reprise en cours (tentative ${String(progress?.attempts ?? 0)}/${String(MAX_ATTEMPTS)})`;
---

{
  failure || !progress ? (
    <ErrorView failure={failure ?? { kind: 'not-found', status: 404 }} />
  ) : (
    <Layout title={`Audit de ${host} – zero-audit`}>
      {isActive && <meta slot="head" http-equiv="refresh" content={String(REFRESH_SECONDS)} />}
      <span class="eyebrow">{isQueued ? "En file d'attente" : isActive ? 'Audit en cours' : 'Audit interrompu'}</span>
      <h1>Audit de {host}</h1>
      {isActive ? (
        <>
          <p>{isQueued ? queueLine : summary}</p>
          {isResumed && <p class="resume-note">{resumeLine}</p>}
          {hasCount && (
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}>
              <div class="progress-bar" style={`width: ${String(percent)}%`}></div>
            </div>
          )}
        </>
      ) : (
        <>
          <p class="alert alert-error" role="alert">L'audit de {host} a échoué.</p>
          {Astro.locals.user && (
            <RelaunchForm url={progress.rootUrl} limit={relaunchLimit(progress.pagesLimit)} />
          )}
        </>
      )}
    </Layout>
  )
}
