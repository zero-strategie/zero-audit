---
import ErrorView from '../../components/ErrorView.astro';
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LIMIT, limitsUpTo } from '../../lib/audit-limits';
import { Conflict, InvalidRequest, TooManyRequests, Unauthenticated } from '../../lib/api/errors';
import { toFailure } from '../../lib/failure';
import { isSameOrigin } from '../../lib/same-origin';

const HTTP_FORBIDDEN = 403;
const HTTP_SEE_OTHER = 303;
const SIGN_IN_THEN_LAUNCH = '/connexion?retour=/audits/new';

const user = Astro.locals.user;
if (Astro.request.method === 'POST' && !isSameOrigin(Astro.request)) {
  return new Response('Forbidden', { status: HTTP_FORBIDDEN });
}
if (!user) return Astro.redirect(SIGN_IN_THEN_LAUNCH, HTTP_SEE_OTHER);
const offeredLimits = limitsUpTo(user.pagesLimitMax);

let url = '';
let limit: number = DEFAULT_LIMIT;
let message: string | null = null;
let failure = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  url = String(form.get('url') ?? '').trim();
  const requestedLimit = Number(form.get('limit'));
  limit = Number.isInteger(requestedLimit) ? requestedLimit : DEFAULT_LIMIT;
  try {
    const { snapshotId } = await Astro.locals.apiClient.startAudit({ url, limit });
    return Astro.redirect(`/audits/${encodeURIComponent(snapshotId)}`, HTTP_SEE_OTHER);
  } catch (error) {
    if (error instanceof Unauthenticated) return Astro.redirect(SIGN_IN_THEN_LAUNCH, HTTP_SEE_OTHER);
    if (
      error instanceof InvalidRequest ||
      error instanceof Conflict ||
      error instanceof TooManyRequests
    ) {
      message = error.message;
    } else {
      failure = toFailure(error);
      Astro.response.status = failure.status;
    }
  }
}
---

{
  failure ? (
    <ErrorView failure={failure} />
  ) : (
    <Layout title="Lancer un audit – zero-audit">
      <h1>Lancer un audit</h1>
      {message && <p class="alert alert-error" role="alert">{message}</p>}
      <form method="post" action="/audits/new" class="form-launch panel">
        <label>
          Adresse du site
          <input type="url" name="url" value={url} placeholder="https://exemple.fr/" required />
        </label>
        <label>
          Pages maximum
          <select name="limit">
            {offeredLimits.map((allowed) => (
              <option value={allowed} selected={allowed === limit}>{allowed}</option>
            ))}
          </select>
        </label>
        <button type="submit" class="button-primary">Lancer l'audit</button>
      </form>
    </Layout>
  )
}
