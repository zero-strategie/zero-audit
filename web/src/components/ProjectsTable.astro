---
import type { ProjectOverview } from '../lib/api/types';
import { DEFAULT_LIMIT } from '../lib/audit-limits';
import { formatDateFr } from '../lib/presentation';
import RelaunchForm from './RelaunchForm.astro';

interface Props {
  projects: ProjectOverview[];
  /** A relaunch needs an account: the button is hidden from visitors. */
  canRelaunch: boolean;
}
const { projects, canRelaunch } = Astro.props;
---

<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Site</th><th scope="col">Santé</th><th scope="col">Dernier audit</th><th scope="col">Statut</th>
        {canRelaunch && <th scope="col">Action</th>}
      </tr>
    </thead>
    <tbody class="reveal-on-scroll">
      {projects.map(({ id, rootUrl, latestSnapshot, latestRun }) => (
        <tr data-testid={`project-${id}`}>
          <td class="cell-site">{rootUrl}</td>
          {latestSnapshot ? (
            <>
              <td class="cell-health">
                {latestSnapshot.health === null ? (
                  'Non calculable'
                ) : (
                  <>
                    <span class="mini-meter" aria-hidden="true">
                      <i style={`--v: ${String(latestSnapshot.health / 100)}`} />
                    </span>
                    {latestSnapshot.health}
                  </>
                )}
              </td>
              <td><a href={`/snapshots/${latestSnapshot.id}`}>{formatDateFr(latestSnapshot.finishedAt)}</a></td>
            </>
          ) : (
            <td colspan="2">Aucun audit terminé</td>
          )}
          <td>
            {latestRun?.status === 'running' && (
              <a class="chip chip-running" href={`/audits/${latestRun.id}`}>en cours…</a>
            )}
            {latestRun?.status === 'queued' && (
              <a class="chip chip-queued" href={`/audits/${latestRun.id}`}>en file</a>
            )}
            {latestRun?.status === 'failed' && <span class="chip chip-failed">échoué</span>}
          </td>
          {canRelaunch && (
            <td><RelaunchForm url={rootUrl} limit={DEFAULT_LIMIT} ariaLabel={`Relancer l'audit de ${new URL(rootUrl).host}`} /></td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
