---
interface Props {
  url: string;
  limit: number;
  label?: string;
  ariaLabel?: string;
}
const { url, limit, label = 'Relancer', ariaLabel } = Astro.props;
---

<form method="post" action="/audits/new">
  <input type="hidden" name="url" value={url} />
  <input type="hidden" name="limit" value={limit} />
  <button type="submit" class="button-primary" aria-label={ariaLabel}>{label}</button>
</form>
