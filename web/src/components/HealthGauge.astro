---
import { formatScoreWithVariation } from '../lib/presentation';

interface Props {
  score: number | null;
  variation: number | null;
}

const { score, variation } = Astro.props;
const label = formatScoreWithVariation(score, variation);
const arc = score ?? 0;
const trend =
  variation === null || variation === 0
    ? ''
    : variation > 0
      ? 'variation-positive'
      : 'variation-negative';
const trendText =
  variation === null ? '' : variation === 0 ? '= 0' : `${variation > 0 ? '↑' : '↓'} ${String(Math.abs(variation))}`;

/* A 270° dial (gap at the bottom) on a 240 × 240 view box: arc of radius 96, ticks of radius 108. */
const ARC = 'M 52.12 187.88 A 96 96 0 1 1 187.88 187.88';
const TICKS = 'M 43.63 196.37 A 108 108 0 1 1 196.37 196.37';
---

<div
  class="health-gauge"
  role="img"
  aria-label={`Santé du site : ${label}`}
  style={`--score: ${String(arc)}`}
  data-state={score === null ? 'na' : 'ok'}
>
  <svg viewBox="0 0 240 240" aria-hidden="true" focusable="false">
    <path class="gauge-track" pathLength="100" d={ARC}></path>
    <path class="gauge-ticks" pathLength="100" d={TICKS}></path>
    <path class="gauge-ticks-major" pathLength="100" d={TICKS}></path>
    <path class="gauge-arc" pathLength="100" d={ARC} stroke-dasharray={`${String(arc)} 100`}></path>
    <text class="gauge-scale" x="30" y="226">0</text>
    <text class="gauge-scale" x="196" y="226">100</text>
    <g class="gauge-needle">
      <line x1="120" y1="120" x2="120" y2="40"></line>
      <circle cx="120" cy="120" r="5"></circle>
    </g>
  </svg>
  <div class="gauge-readout" aria-hidden="true">
    {
      score === null ? (
        <span class="gauge-value gauge-value-na">—</span>
      ) : (
        <span class="gauge-value" style={`--n: ${String(score)}`} />
      )
    }
    <span class:list={['gauge-trend', trend]}>{score === null ? 'Non calculable' : trendText}</span>
  </div>
  <strong class:list={['gauge-label', trend]} data-testid="health-score">{label}</strong>
</div>
