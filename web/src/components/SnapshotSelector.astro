---
import type { SnapshotListing } from '../lib/api/types';
import { SNAPSHOT_STATUS_LABELS } from '../lib/labels';
import { formatDateFr } from '../lib/presentation';

interface Props {
  snapshots: SnapshotListing[];
  currentId: string;
}
const { snapshots, currentId } = Astro.props;
---

<form action="/snapshots" method="get">
  <label>
    Audit
    <select name="id">
      {
        snapshots.map(({ id, status, startedAt }) => (
          <option value={id} selected={id === currentId} disabled={status === 'failed'}>
            {formatDateFr(startedAt)} – {SNAPSHOT_STATUS_LABELS[status]}
          </option>
        ))
      }
    </select>
  </label>
  <button type="submit">Ouvrir</button>
</form>
