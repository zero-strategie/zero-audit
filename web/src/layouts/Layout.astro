---
import MainNav from '../components/MainNav.astro';
import { resolveSourceUrl } from '../lib/source';
import globalStylesheet from '../styles/global.css?url';

interface Props {
  title: string;
  projectId?: string | undefined;
  snapshotId?: string | undefined;
}
const { title, projectId, snapshotId } = Astro.props;
const sourceUrl = resolveSourceUrl(process.env);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={globalStylesheet} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header"><MainNav user={Astro.locals.user} projectId={projectId} snapshotId={snapshotId} /></header>
    <main><slot /></main>
    <footer class="site-footer" data-testid="site-footer">
      zero-audit · licence AGPL-3.0 ·
      <a href={sourceUrl}>Code source</a> ·
      <a href="/confidentialite">Confidentialité</a>
    </footer>
  </body>
</html>
